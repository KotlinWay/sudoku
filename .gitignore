# Сборка и кэши Gradle
build/
.gradle/
.worktrees/

# Собранный релизный APK. Лежит вне build/, потому что его кладут сюда руками
# перед выкладкой, но это всё равно продукт сборки, а не исходник.
app/release/

# Снимки экрана и дампы дерева доступности, которыми меряют вёрстку.
# Живут ровно до конца задачи, ради которой сняты.
artifacts/

# Путь к SDK свой на каждой машине
local.properties

# Боевой ключ и пароли к нему. В репозиторий не попадают никогда:
# потеря ключа означает, что приложение больше нельзя обновить, а утечка —
# что обновление может выпустить кто угодно.
keystore.properties
keystore
*.jks
*.keystore
*.p12
*.pfx

