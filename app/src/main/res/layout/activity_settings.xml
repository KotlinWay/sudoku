<?xml version="1.0" encoding="utf-8"?>
<!--
    Настройки. На экране только то, что настраивают: разделы «Игра» и «Оформление».
    Связь с автором ушла под три точки бара (res/menu/settings.xml): семь ссылок подряд
    занимали больше места, чем сами настройки, а открывают их раз в жизни.

    Блок про Блокнот Енот стоит последним намеренно: это не настройка, а рассказ о другом
    приложении, и человек, пришедший сюда включить звук, не должен об него спотыкаться.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <!-- ── Игра ─────────────────────────────────────────────────────── -->

        <TextView
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_game" />

        <Switch
            android:id="@+id/candidates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:text="@string/candidates"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/candidates_hint" />

        <Switch
            android:id="@+id/sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target"
            android:text="@string/sound"
            android:textColor="@color/on_background"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_hint" />

        <!-- ── Оформление ───────────────────────────────────────────────── -->

        <View style="@style/Divider" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme" />

        <!--
            Три возможности переключателем не показать: «как в системе» — это не «выключено».
            Радиокнопки говорят прямо, что выбор один из трёх и что он сделан.
        -->
        <RadioGroup
            android:id="@+id/theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/theme_system"
                style="@style/Choice"
                android:text="@string/theme_system" />

            <RadioButton
                android:id="@+id/theme_light"
                style="@style/Choice"
                android:text="@string/theme_light" />

            <RadioButton
                android:id="@+id/theme_dark"
                style="@style/Choice"
                android:text="@string/theme_dark" />
        </RadioGroup>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_hint" />

        <!-- ── Подвал ───────────────────────────────────────────────────── -->

        <View style="@style/Divider" />

        <TextView
            android:id="@+id/version"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ── Блокнот Енот ─────────────────────────────────────────────── -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/raccoon_title" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/raccoon_text" />

            <Button
                android:id="@+id/raccoon"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/raccoon_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
