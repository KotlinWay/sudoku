<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorPrimary">@color/accent</item>
        <!--
            Акцент виджетов — тёмная доля золота, а не сам жёлтый. Платформа красит им
            тонкие вещи: включённый ползунок, отмеченную радиокнопку. Жёлтый #FFD33E на
            почти белой странице давал 1,3:1, и органы управления на экране настроек
            приходилось искать глазами. Заливкой жёлтый остался: бар, выбранная клетка,
            нажатая клавиша — там он работает площадью, и контраст считается по надписи
            на нём, а не по нему самому.
        -->
        <item name="android:colorAccent">@color/accent_on_surface</item>
        <item name="android:colorControlActivated">@color/accent_on_surface</item>
        <!--
            Выключенный переключатель платформа рисует почти белым, а радиокнопку — тонким
            светлым кольцом: на странице #F1F1EC это белое по белому. Берём приглушённый
            цвет подписей, он даёт 5,3:1 в светлой теме и 6,2:1 в тёмной. Состояние при
            этом читается положением ползунка и наличием точки, а не одним лишь цветом.
        -->
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:actionBarStyle">@style/ActionBar</item>
        <item name="android:actionOverflowButtonStyle">@style/Overflow</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:actionOverflowMenuStyle">@style/OverflowMenu</item>
        <item name="android:alertDialogTheme">@style/AlertDialog</item>
        <item name="android:statusBarColor">@color/accent_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <!--
            Линия под баром задана темой, а не разметками: система рисует windowContentOverlay
            поверх содержимого ровно по нижнему краю бара, на каждом экране и без копий
            в вёрстке.
        -->
        <item name="android:windowContentOverlay">@drawable/toolbar_line</item>
    </style>

    <!--
        Нативный бар красится темой, а не библиотечным Toolbar: AndroidX в проекте нет.
        Фон задан прямо, а не только через colorPrimary: тема DayNight в тёмном режиме
        подставила бы баровые цвета сама. Заголовок чёрным — тоже явно: иначе он берётся
        из textColorPrimary и ночью стал бы белым на жёлтом.
    -->
    <style name="ActionBar" parent="@android:style/Widget.DeviceDefault.ActionBar">
        <item name="android:background">@color/accent</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle</item>
    </style>

    <style name="ActionBarTitle" parent="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <!--
        Три точки в баре. Свой значок, а не платформенный: платформенный красится
        textColorPrimary, то есть цветом надписей на фоне страницы, а стоит он на жёлтом
        баре. В светлой теме это сходило с рук — там textColorPrimary почти чёрный и
        совпадал с нашими значками; в тёмной он стал светло-серым, и точки побелели
        на золоте: контраст 1,6:1 при нормативе 3:1 для нетекстовых элементов.

        Значок берётся тот же, что и у полосы инструментов в альбоме, — так три точки
        в двух ориентациях остаются одной и той же кнопкой, а не двумя похожими.
    -->
    <style name="Overflow" parent="@android:style/Widget.DeviceDefault.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_more</item>
        <item name="android:tint">@color/on_accent</item>
        <!--
            Платформа даёт кнопке переполнения 40dp по ширине — у неё своя мера,
            `action_button_min_width_overflow_material`, а не общая 48dp, которая стоит
            у остальных пунктов бара. Замерено дампом дерева доступности на экране настроек:
            40x48. Ширину поднимаем до общего норматива: это единственное место
            в приложении, где тач-таргет был меньше 48dp.
        -->
        <item name="android:minWidth">@dimen/touch_target</item>
    </style>

    <!--
        Список под тремя точками. Платформенный фон в тёмной теме синевато-серый (#3C4043),
        и рядом с угольной поверхностью приложения (#252525) он читается заплаткой из
        чужого приложения. Фон взят наш — тот же, что у плиток и клавиш.

        Стиль один на оба списка: в портрете его открывает бар, в альбоме — PopupMenu
        из полосы инструментов, и оба берут popupMenuStyle из темы.
    -->
    <style name="PopupMenu" parent="@android:style/Widget.DeviceDefault.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_tile</item>
    </style>

    <!--
        Список бара — не тот же виджет, что PopupMenu: он берёт actionOverflowMenuStyle,
        а popupMenuStyle не читает вовсе. Проверено заменой одного и снимком экрана,
        на котором ничего не поменялось. Поэтому стилей два, а фон в них один.
    -->
    <style name="OverflowMenu" parent="@android:style/Widget.DeviceDefault.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_tile</item>
    </style>

    <!--
        Окна статистики и подтверждения сброса. Диалог берёт свою тему из alertDialogTheme,
        а не из темы экрана, поэтому наш акцент до его кнопок не доходил и они оставались
        платформенно-синими среди жёлтого приложения. Предок — DayNight-вариант: без него
        диалог остался бы тёмным в светлой теме.
    -->
    <style name="AlertDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent_on_surface</item>
    </style>

    <!--
        Точка в имени стиля — это наследование: AAPT2 ищет предка «Text» у «Text.Body»
        и падает, если такого стиля нет. Поэтому семейства объявлены явно. Предками взяты
        платформенные виджеты: кнопка сохраняет свои отступы, центрирование и отклик
        на нажатие, а мы переопределяем только фон и цвета.
    -->
    <style name="Text" parent="@android:style/Widget.DeviceDefault.TextView" />

    <!--
        Плоские кнопки: у платформенной кнопки есть stateListAnimator, поднимающий её над
        поверхностью, и оттого настоящая тень. Рисуется тень **за** границами View, а ряды
        клавиш подогнаны под кнопки впритык — родитель её обрезал, и от тени оставалась
        полоска в один пиксель снизу да размытие в зазорах между клавишами.

        Тень убрана, а не дана ей место: во всём приложении ничего не отбрасывает теней —
        ни плитки, ни доска, ни панели, — и клавиши были единственным исключением, к тому же
        обрезанным. Нажатие видно и без подъёма: `bg_key` красит нажатую клавишу в акцент.
    -->
    <style name="Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/on_background</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!--
        Заголовок раздела настроек. Отличается от подписи начертанием, а не размером и не
        цветом: раздела всего три, и лишний оттенок на экране ради них заводить незачем.
    -->
    <style name="Text.Section">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>

    <!-- Черта между разделами настроек. Отступы её же: разделяет она, ей и держать воздух. -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/space_xl</item>
        <item name="android:layout_marginBottom">@dimen/space_xl</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!--
        Строка выбора из нескольких. Кружок красится списком состояний, а не одним цветом:
        отмеченный — акцентом, пустые — приглушённым. Одним `accent` он красился раньше,
        и пустые кольца жёлтым по почти белому давали 1,3:1.
    -->
    <style name="Choice" parent="@android:style/Widget.DeviceDefault.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:buttonTint">@color/control</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!--
        Переключатель настройки. Заведён стилем, а не шестью повторяющимися атрибутами
        на каждом из двух: тинты ползунка и дорожки всё равно пришлось бы держать
        одинаковыми, а расходятся такие пары при первой же правке.

        Тинт задаётся здесь, а не темой: платформенный `colorSwitchThumbNormal`,
        который красит выключенный ползунок, помечен private — линковка на нём падает.

        Предка у стиля нет, и это не забывчивость: `Widget.DeviceDefault.CompoundButton.Switch`
        в платформе тоже private. Он и не нужен — всё, что здесь не перечислено, виджет
        возьмёт из `switchStyle` темы, как берёт и без нашего стиля.
    -->
    <style name="Toggle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:thumbTint">@color/control</item>
        <item name="android:trackTint">@color/switch_track</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!--
        Кнопка в полосе инструментов (только альбом). Фон полосы жёлтый, поэтому у самой
        кнопки фона нет — только отклик на нажатие; значок красится в цвет надписей на
        акценте, как и значки бара в портрете.
    -->
    <style name="Tool">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/on_accent</item>
    </style>

    <!-- Клавиша с цифрой. Крупная, спокойная, на всю доступную ширину. -->
    <style name="Key" parent="@style/Button">
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Quiet">
        <item name="android:background">@drawable/bg_button_quiet</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
