    <color name="cell_selected">#453D1B</color>
    <color name="cell_wrong">#452020</color>
    <color name="board_line">#24406B</color>
    <color name="board_frame">#6C8BBF</color>

    <color name="digit_given">#F2F5FA</color>
    <color name="digit_player">#7FB2FF</color>
