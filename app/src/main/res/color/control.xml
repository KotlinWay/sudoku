<?xml version="1.0" encoding="utf-8"?>
<!--
    Цвет органа управления: отмеченная радиокнопка и ползунок включённого переключателя
    красятся акцентом, выключенные — приглушённым цветом подписей.

    Раньше и то и другое красилось `accent`, то есть самим жёлтым, а выключенное платформа
    оставляла почти белым. На странице #F1F1EC это давало 1,3:1 у включённого и белое
    по белому у выключенного при нормативе 3:1 для нетекстовых элементов.

    Список один на переключатель и радиокнопку намеренно: это один и тот же вопрос
    «включено или нет», и разъехаться в цвете они не должны.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/accent_on_surface" />
    <item android:color="@color/muted" />
</selector>
