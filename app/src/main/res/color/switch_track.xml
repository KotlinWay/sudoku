<?xml version="1.0" encoding="utf-8"?>
<!--
    Дорожка переключателя серая в обоих положениях, а не золотая во включённом.

    Причина не в контрасте, а в правиле «на светлом фоне ничего золотого тонкой линией».
    Дорожку платформа рисует своим drawable с собственной прозрачностью, и наша
    прозрачность на неё домножается: даже при alpha 1 дорожка выходит бледной. Бледное
    золото на почти белой странице — это ровно то жёлтое-по-белому, из-за которого
    экран и переделывался, только теперь ещё и площадью в палец.

    Поэтому дорожка — нейтральная канавка, а состояние несёт ползунок: положением
    и цветом сразу. Прозрачность взята 1, чтобы канавка была видна: платформа ужмёт
    её сама.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/muted" />
</selector>
