<?xml version="1.0" encoding="utf-8"?>
<!--
    Экран игры в альбоме. Дефицит здесь обратный портретному: высоты 320dp на всё,
    а ширины 592dp — вдвое больше, чем доске нужно. Поэтому всё, что в портрете стоит
    поперёк экрана, здесь встало вдоль.

    Бар лежачим быть не может: он забирал 56dp высоты, то есть 56dp стороны доски.
    Инструменты вынесены полосой слева — она берёт ширину, которой некуда деваться,
    и не берёт высоту. Заголовок с уровнем и счётчики переехали строкой над клавишами:
    в полосу шириной 56dp название уровня не помещается.

    Доска стоит слева от клавиш и берёт высоту целиком — она сама делает себя квадратной
    по меньшей стороне, а меньшая здесь высота.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!--
            Полоса инструментов. Тот же жёлтый, что и у бара в портрете: это он и есть,
            повёрнутый набок, — а не набор кнопок, заведённый рядом с доской.
        -->
        <LinearLayout
            android:id="@+id/tools"
            android:layout_width="@dimen/tools_strip"
            android:layout_height="match_parent"
            android:background="@color/accent"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/tool_undo"
                style="@style/Tool"
                android:contentDescription="@string/tool_undo"
                android:src="@drawable/ic_undo" />

            <!-- Подсказки в полосе нет: она счётчиком-кнопкой над клавишами, см. menu/game.xml. -->
            <ImageButton
                android:id="@+id/tool_pause"
                style="@style/Tool"
                android:contentDescription="@string/tool_pause"
                android:src="@drawable/ic_pause" />

            <!--
                Переполнение прижато к низу полосы. Не ради вида: список под ним раскрывается
                от кнопки, и стоя пятым сверху он упирался в край экрана — «Настройки»
                уезжали под прокрутку.
            -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/tool_more"
                style="@style/Tool"
                android:contentDescription="@string/tool_more"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="@dimen/space_s">

            <!--
                Доска. Ширина по содержимому: доска ответит стороной, равной высоте,
                и контейнер станет ровно квадратом — остальная ширина достанется клавишам,
                а не полям.
            -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <info.javaway.sudoku.ui.game.BoardView
                    android:id="@+id/board"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/generating"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_badge"
                    android:padding="@dimen/space_m"
                    android:text="@string/generating"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="vertical">

                <!--
                    Уровень отдельной строкой, а не рядом со счётчиками: «Эксперт» рядом
                    с тремя сердцами, подсказками и часами обрезался бы многоточием.
                -->
                <TextView
                    android:id="@+id/level"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs" />

                <!--
                    Счётчики без плашек: строка узкая, и подложки съели бы место, которого
                    здесь нет. Отделять их от фона нечем и незачем — рядом только клавиши.
                -->
                <LinearLayout
                    android:id="@+id/counters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_xs">

                    <LinearLayout
                        android:id="@+id/hearts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!--
                        Тот же счётчик-кнопка, что и в портрете, см. layout/activity_game.xml.
                        Плашка тут есть, хотя у соседей её нет: у часов подложка была бы
                        украшением, а у этой вьюхи она говорит, что на неё нажимают.
                    -->
                    <TextView
                        android:id="@+id/hints"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_button"
                        android:drawableStart="@drawable/ic_hint"
                        android:drawablePadding="@dimen/space_xs"
                        android:drawableTint="@color/badge_hint"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/space_s"
                        android:paddingEnd="@dimen/space_m"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_xs"
                        android:textColor="@color/badge_hint" />

                    <TextView
                        android:id="@+id/timer"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:textColor="@color/on_surface"
                        android:typeface="monospace" />
                </LinearLayout>

                <!--
                    Клавиатура: обычно 1–5 в левом столбце, 6–9 и стирание в правом.
                    При крупном шрифте пять рядов не помещаются по 48dp, поэтому тот же
                    контейнер перестраивает клавиши в два ряда по пять.
                -->
                <info.javaway.sudoku.ui.game.AdaptiveKeypadLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_s"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/key_1"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_2"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_3"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_4"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_5"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_6"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_7"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_8"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/key_9"
                        style="@style/Key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageButton
                        android:id="@+id/key_erase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_key"
                        android:contentDescription="@string/erase"
                        android:minHeight="@dimen/touch_target"
                        android:scaleType="center"
                        android:src="@drawable/ic_erase"
                        android:stateListAnimator="@null"
                        android:tint="@color/on_surface" />
                </info.javaway.sudoku.ui.game.AdaptiveKeypadLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
        Панель итогов: пауза, победа, поражение. Одна разметка на три случая — состав у них
        совпадает, а три копии разошлись бы при первой же правке.

        В альбоме карточка выше экрана: заголовок, объяснение, приписка и две кнопки просят
        около 280dp при 336dp всего. Поэтому она в прокрутке — обрезанная карточка прячет
        как раз кнопки, то есть единственный выход с панели.
    -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/space_l"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/panel_title"
                    style="@style/Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/panel_text"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/panel_note"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center" />

                <Button
                    android:id="@+id/panel_primary"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <Button
                    android:id="@+id/panel_secondary"
                    style="@style/Button.Quiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <info.javaway.sudoku.ui.game.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
