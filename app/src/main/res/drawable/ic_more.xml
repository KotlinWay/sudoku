<?xml version="1.0" encoding="utf-8"?>
<!--
    Три точки. Значок один на обе ориентации: в портрете он стоит кнопкой переполнения
    в баре (см. стиль Overflow), в альбоме бара нет — там он в полосе слева.

    Точки диаметром 4 с шагом 6, то есть просвет между ними 2. Шаг здесь не украшение:
    при шаге 4 точки того же диаметра смыкаются вплотную, и значок читается вертикальной
    колбаской, а не тремя точками. Ровно так и было — замерено на снимке экрана.
    Геометрия взята у платформенного значка, чтобы кнопка не выглядела в баре чужой.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/on_accent"
        android:pathData="M12,6m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="@color/on_accent"
        android:pathData="M12,12m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />
    <path
        android:fillColor="@color/on_accent"
        android:pathData="M12,18m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />
</vector>
