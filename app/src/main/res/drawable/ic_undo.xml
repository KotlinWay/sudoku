<?xml version="1.0" encoding="utf-8"?>
<!--
    Значки инструментов рисуются контуром в две точки со скруглёнными концами, а не заливкой.
    Заливка на жёлтом баре собирается в чёрное пятно: цвет тот же, а массы вчетверо больше,
    и глаз читает не значок, а кляксу. Контур держит тот же контраст при вчетверо меньшей массе.
-->
